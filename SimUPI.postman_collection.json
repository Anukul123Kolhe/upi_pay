{
  "info": {
    "name": "SimUPI Payment Simulation API Collection",
    "description": "Comprehensive Postman test collection for Simulated UPI Payment Web Application",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login - Anukul Sharma",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"9876543210\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "http://localhost:8080/api/auth/login", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Get Current Logged-in User Profile",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8080/api/auth/me", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "Register New User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rohan Gupta\",\n  \"mobile\": \"9811122233\",\n  \"email\": \"rohan@simupi.com\",\n  \"password\": \"password123\",\n  \"bankName\": \"HDFC Bank\",\n  \"accountType\": \"SAVINGS\",\n  \"openingBalance\": 30000.00,\n  \"upiPin\": \"1234\"\n}"
            },
            "url": { "raw": "http://localhost:8080/api/auth/register", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Set or Change UPI PIN",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"password123\",\n  \"newPin\": \"4321\"\n}"
            },
            "url": { "raw": "http://localhost:8080/api/auth/pin", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "auth", "pin"] }
          }
        },
        {
          "name": "Logout Session",
          "request": {
            "method": "POST",
            "url": { "raw": "http://localhost:8080/api/auth/logout", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "2. Bank Account & Balance",
      "item": [
        {
          "name": "Check Balance (PIN Protected)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"upiPin\": \"1234\"\n}"
            },
            "url": { "raw": "http://localhost:8080/api/account/balance", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "account", "balance"] }
          }
        },
        {
          "name": "Get Linked Bank Accounts",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8080/api/account/linked", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "account", "linked"] }
          }
        }
      ]
    },
    {
      "name": "3. Payments & Transfers",
      "item": [
        {
          "name": "Verify Receiver by UPI ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8080/api/payments/search?query=priya@simupi",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "payments", "search"],
              "query": [{ "key": "query", "value": "priya@simupi" }]
            }
          }
        },
        {
          "name": "Verify Receiver by Mobile Number",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8080/api/payments/search?query=9876543211",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "payments", "search"],
              "query": [{ "key": "query", "value": "9876543211" }]
            }
          }
        },
        {
          "name": "Send Money (Atomic P2P Transfer)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiverQuery\": \"priya@simupi\",\n  \"amount\": 1500.00,\n  \"note\": \"Dinner bill split\",\n  \"upiPin\": \"1234\"\n}"
            },
            "url": { "raw": "http://localhost:8080/api/payments/send", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "payments", "send"] }
          }
        },
        {
          "name": "Create Collect Money Request",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payerQuery\": \"rahul@simupi\",\n  \"amount\": 800.00,\n  \"note\": \"Cab fare share\"\n}"
            },
            "url": { "raw": "http://localhost:8080/api/payments/collect", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "payments", "collect"] }
          }
        }
      ]
    },
